# Copied to /etc/lesswrong-bot.env by deploy.sh if that file doesn't exist yet.
# Edit it there (not here) for per-server settings and secrets; it isn't in git.

# Whole-thread pages: the bot writes HTML here, and a web server must serve this
# directory at THREAD_URL. On hetzner, nginx serves /srv/the.shawwn.net as
# https://the.shawwn.net/ (see /etc/nginx/sites-available/the.shawwn.net).
# Leave these unset to disable thread pages; tweets then get Twitter's embed link.
THREAD_DIR=/srv/the.shawwn.net/t
THREAD_URL=https://the.shawwn.net/t

# #lw-test is for trying the bot out without spamming #lesswrong.
IRC_CHANNELS="#lesswrong,#lw-test"

# IRC_NICK=sbot
# IRC_SASL_USER=sbot
# IRC_SASL_PASS=...
